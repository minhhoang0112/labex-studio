# LabEx Local Configuration
PORT=5000
HOST=127.0.0.1
WSL_DISTRO=Ubuntu
# namespace uses the installed WSL userspace; docker uses the installed
# private rootless engine and the labex-local/ubuntu22:1 image.
LABEX_RUNTIME_PROVIDER=namespace

# (Tùy chọn) Điền API Key của bạn để sử dụng AI nâng cao.
# Nếu để trống, hệ thống sẽ tự động sử dụng trợ lý AI Offline có sẵn!
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
# Native bidirectional voice; separate from the text chat model.
GEMINI_LIVE_MODEL=gemini-3.8-live
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=

# Azure VM lifecycle and remote PowerShell. Login with scripts/azure-login.ps1.
AZURE_AUTH_MODE=cli
AZURE_SUBSCRIPTION_ID=
AZURE_VM_RG=LabEx-India-RG
AZURE_VM_NAME=LabEx-WinServer
AZURE_VM_IP=20.40.49.168
# Other supported auth modes: service-principal or managed-identity.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# RDP credentials stay on the backend. Never put these in VITE_* variables.
WINDOWS_ADMIN_USERNAME=adminlab
WINDOWS_ADMIN_PASSWORD=
WINDOWS_RDP_DOMAIN=
WINDOWS_RDP_PORT=3389
# Enable only for this known lab VM's self-signed RDP certificate.
WINDOWS_RDP_IGNORE_CERT=false
GUACD_HOST=127.0.0.1
GUACD_PORT=4822

