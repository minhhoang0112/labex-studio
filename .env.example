# LabEx Local Configuration
PORT=5000
HOST=127.0.0.1
WSL_DISTRO=Ubuntu
# namespace uses the installed WSL userspace; docker uses the installed
# private rootless engine and the labex-local/ubuntu22:1 image.
LABEX_RUNTIME_PROVIDER=namespace

# (Tùy chọn) Điền API Key của bạn để sử dụng AI nâng cao.
# Nếu để trống, hệ thống sẽ tự động sử dụng trợ lý AI Offline có sẵn!
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=

