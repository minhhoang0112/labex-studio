    {
      "lab_id": "linux-permissions-of-files",
      "source_lab_id": 270252,
      "setup_manifest": "server/data/environment-setups/linux-permissions-of-files.json",
      "steps": [
        {
          "id": "source-270252-section-1",
          "commands": [
            "cd ~/project",
            "touch example.txt",
            "ls"
          ]
        },
        {
          "id": "source-270252-section-2",
          "commands": [
            "ls -l example.txt",
            "sudo chown root:root example.txt",
            "ls -l example.txt"
          ]
        },
        {
          "id": "source-270252-section-3",
          "commands": [
            "mkdir -p new-dir/subdir",
            "echo \"Hello, world\" > new-dir/file1.txt",
            "echo \"Another file\" > new-dir/subdir/file2.txt",
            "sudo chown -R root:root new-dir",
            "ls -lR new-dir"
          ]
        },
        {
          "id": "source-270252-section-4",
          "commands": [
            "sudo chmod 700 example.txt",
            "ls -l example.txt"
          ]
        },
        {
          "id": "source-270252-section-5",
          "commands": [
            "mkdir ~/test-dir",
            "chmod 700 ~/test-dir",
            "ls -ld ~/test-dir",
            "chmod -R 755 ~/test-dir",
            "ls -ld ~/test-dir"
          ]
        },
        {
          "id": "source-270252-section-6",
          "commands": [
            "cd ~/project",
            "printf '#!/bin/bash\\necho \"Hello, World\"\\n' > script.sh",
            "chmod u+x script.sh",
            "./script.sh"
          ]
        }
      ]
    },
    {
      "lab_id": "shell-change-file-ownership",
