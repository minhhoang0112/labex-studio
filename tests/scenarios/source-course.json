      "lab_id": "linux-basic-files-operations",
      "source_lab_id": 270248,
      "setup_manifest": "server/data/environment-setups/linux-basic-files-operations.json",
      "steps": [
        {
          "id": "source-270248-section-1",
          "commands": [
            "pwd",
            "echo ~",
            "ls",
            "ls ~"
          ]
        },
        {
          "id": "source-270248-section-2",
          "commands": [
            "pwd",
            "ls",
            "cd ..",
            "pwd",
            "cd project",
            "cd ~",
            "pwd",
            "cd /home/labex/project"
          ]
        },
        {
          "id": "source-270248-section-3",
          "commands": [
            "touch file1.txt",
            "echo \"Hello, Linux\" > file2.txt",
            "echo \"Hidden file\" > .hiddenfile",
            "mkdir testdir",
            "ls",
            "ls -l",
            "ls -a",
            "ls -la",
            "ls -l testdir"
          ]
        },
        {
          "id": "source-270248-section-4",
          "commands": [
            "cp file1.txt file1_copy.txt",
            "cp file2.txt testdir/",
            "cp -r testdir testdir_copy"
          ]
        },
        {
          "id": "source-270248-section-5",
          "commands": [
            "mv file1.txt newname.txt",
            "mv newname.txt testdir/",
            "mv testdir_copy new_testdir",
            "mv testdir/newname.txt ./original_file1.txt"
          ]
        },
        {
          "id": "source-270248-section-6",
          "commands": [
            "rm original_file1.txt",
            {
              "command": "rm -i file2.txt",
              "input": [
                {
                  "wait_for": "?",
                  "text": "y"
                }
              ]
            },
            {
              "command": "rmdir new_testdir",
              "allowed_status": [
                1
              ]
            },
            {
              "command": "rmdir testdir",
              "allowed_status": [
                1
              ]
            },
            "rm -r testdir",
            "rm .hiddenfile",
            "mkdir temp_dir",
            "touch temp_dir/temp_file.txt",
            "ls -R temp_dir",
            "rm -rf temp_dir"
          ]
        }
      ]
    },
