    {
      "lab_id": "linux-user-account-management",
      "source_lab_id": 49,
      "setup_manifest": "server/data/environment-setups/linux-user-account-management.json",
      "steps": [
        {
          "id": "source-49-section-1",
          "commands": [
            "sudo useradd joker",
            "getent passwd joker"
          ]
        },
        {
          "id": "source-49-section-2",
          "commands": [
            "sudo useradd -m bob",
            "ls -ld /home/bob"
          ]
        },
        {
          "id": "source-49-section-3",
          "commands": [
            {
              "command": "sudo passwd joker",
              "input": [
                "ephemeral-test-only",
                "ephemeral-test-only"
              ]
            }
          ]
        },
        {
          "id": "source-49-section-4",
          "commands": [
            "sudo usermod -d /home/wayne joker",
            "getent passwd joker"
          ]
        },
        {
          "id": "source-49-section-5",
          "commands": [
            "sudo usermod -s /bin/bash joker",
            "getent passwd joker"
          ]
        },
        {
          "id": "source-49-section-6",
          "commands": [
            "sudo usermod -aG sudo joker",
            "groups joker",
            {
              "command": "su - joker -c 'sudo -S cat /etc/shadow'",
              "input": [
                {
                  "wait_for": "Password:",
                  "text": "ephemeral-test-only"
                },
                {
                  "wait_for": "password for joker:",
                  "text": "ephemeral-test-only"
                }
              ]
            }
          ]
        },
        {
          "id": "source-49-section-7",
          "commands": [
            "sudo passwd -l joker",
            "sudo passwd -S joker",
            {
              "command": "su - joker -c 'whoami'",
              "input": [
                "ephemeral-test-only"
              ],
              "allowed_status": [
                1
              ]
            },
            "sudo passwd -u joker",
            "sudo passwd -S joker",
            {
              "command": "su - joker -c 'whoami'",
              "input": [
                "ephemeral-test-only"
              ]
            }
          ]
        },
        {
          "id": "source-49-section-8",
          "commands": [
            "sudo userdel -r bob"
          ]
        }
      ]
    },
