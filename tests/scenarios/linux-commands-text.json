    {
      "lab_id": "linux-linux-awk-command-text-processing-388493",
      "source_lab_id": 388493,
      "setup_manifest": "server/data/environment-setups/linux-linux-awk-command-text-processing-388493.json",
      "steps": [
        {
          "id": "commands-388493-section-1-v1",
          "commands": [
            "head server_logs.txt"
          ]
        },
        {
          "id": "commands-388493-section-2-v1",
          "commands": [
            "awk '{print $3, $5}' server_logs.txt | head -n 5"
          ]
        },
        {
          "id": "commands-388493-section-3-v1",
          "commands": [
            "awk '$4 == \"POST\" && $6 >= 400 {print $0}' server_logs.txt"
          ]
        },
        {
          "id": "commands-388493-section-4-v1",
          "commands": [
            "awk '{count[$6]++} END {for (code in count) print code, count[code]}' server_logs.txt | sort -n"
          ]
        },
        {
          "id": "commands-388493-section-5-v1",
          "commands": [
            "cat > log_report.awk <<'AWK'\nfunction top5(counts, heading,    i,k,best) {\n    print \"<h2>\" heading \"</h2><ul>\"\n    for (i=0; i<5; i++) {\n        best=\"\"\n        for (k in counts) if (best==\"\" || counts[k]>counts[best]) best=k\n        if (best==\"\") break\n        print \"<li>\" best \": \" counts[best] \" requests</li>\"\n        delete counts[best]\n    }\n    print \"</ul>\"\n}\nBEGIN { print \"<html><body><h1>Server Log Summary</h1>\" }\n{ total++; if ($6>=400) errors++; ips[$3]++; resources[$5]++ }\nEND {\n    print \"<p>Total requests: \" total \"</p>\"\n    print \"<p>Error rate: \" (total ? 100*errors/total : 0) \"%</p>\"\n    top5(ips,\"Top 5 IP Addresses\")\n    top5(resources,\"Top 5 Requested Resources\")\n    print \"</body></html>\"\n}\nAWK",
            "awk -f log_report.awk server_logs.txt > log_report.html"
          ]
        }
      ]
    },
