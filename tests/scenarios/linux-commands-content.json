      "lab_id": "linux-linux-which-command-command-locating-215210",
      "source_lab_id": 215210,
      "setup_manifest": "server/data/environment-setups/linux-linux-which-command-command-locating-215210.json",
      "steps": [
        {
          "id": "commands-215210-section-1-v1",
          "commands": [
            "which gcc\nwhich python"
          ]
        },
        {
          "id": "commands-215210-section-2-v1",
          "commands": [
            "which techbuild\ncat > ~/check_techbuild.sh <<'EOF'\n#!/bin/bash\nif which techbuild >/dev/null 2>&1; then\n  echo 'techbuild is installed'\nelse\n  echo 'techbuild is not installed'\nfi\nEOF\nchmod +x ~/check_techbuild.sh\n~/check_techbuild.sh"
          ]
        },
        {
          "id": "commands-215210-section-3-v1",
          "commands": [
            "which -a python"
          ]
        },
        {
          "id": "commands-215210-section-4-v1",
          "commands": [
            "export PATH=$HOME/custom_bin:$PATH\nwhich prioritydemo\nwhich -a prioritydemo"
          ]
        },
        {
          "id": "commands-215210-section-5-v1",
          "commands": [
            "cat > ~/hello <<'EOF'\n#!/bin/bash\necho 'Hello from TechCorp!'\nEOF\nchmod +x ~/hello\nexport PATH=\"$PATH:$HOME\"\nhello\nwhich hello"
          ]
        }
      ]
    },
