      "source_lab_id": 590841,
      "setup_manifest": "server/data/environment-setups/comptia-search-text-with-grep-in-linux-590841.json",
      "steps": [
        {
          "id": "comptia-search-text-with-grep-in-linux-590841-step-1",
          "commands": [
            "grep labex /etc/passwd",
            "sudo grep labex /etc/passwd /etc/shadow /etc/group"
          ]
        },
        {
          "id": "comptia-search-text-with-grep-in-linux-590841-step-2",
          "commands": [
            "sudo grep -n labex /etc/passwd /etc/shadow /etc/group"
          ]
        },
        {
          "id": "comptia-search-text-with-grep-in-linux-590841-step-3",
          "commands": [
            "grep root /etc/passwd",
            "grep ^root /etc/passwd",
            "grep bash$ /etc/passwd"
          ]
        },
        {
          "id": "comptia-search-text-with-grep-in-linux-590841-step-4",
          "commands": [
            "grep 'roo*' /etc/passwd",
            "grep 'ro.' /etc/passwd"
          ]
        },
        {
          "id": "comptia-search-text-with-grep-in-linux-590841-step-5",
          "commands": [
            "grep -E 'o{2}' /etc/passwd",
            "grep -E 'root|Root' /etc/passwd"
          ]
        }
      ]
    }
